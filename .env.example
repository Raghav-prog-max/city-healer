# ─── Firebase (sign-in, patient profiles, consents, audit log) ─────────────
# Locally, `npm run dev` starts the Firebase emulators and none of the server values
# below are needed. For a real project see FIREBASE_SETUP.md.

# Server: the Firebase project and its credentials (Application Default Credentials).
# Deployed: give the service a Google service account (workload identity) instead of a key.
# Local against a real project: a service-account key file, never committed (.gitignore'd).
FIREBASE_PROJECT_ID=""
GOOGLE_APPLICATION_CREDENTIALS=""

# Browser: the web app config from Firebase console > Project settings > Your apps.
# These are not secrets. Vite builds them into the frontend, so set them BEFORE `npm run build`.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_APP_ID=""
# "true" only for the local emulators (set in .env.local by default). Never in production.
VITE_FIREBASE_EMULATORS="false"

# Local only: a JDK 11+ for the Firestore emulator, if the default `java` is older.
FIREBASE_JAVA_HOME=""

# ─── Required in production ────────────────────────────────────────────────

# Must be "production" on a deployed host. Anything else starts the Vite dev
# middleware instead of serving the built frontend from dist/.
NODE_ENV="production"

# Where the SQLite file lives (hospitals, doctors, appointments, records). On a host
# with ephemeral disk this MUST point at a mounted persistent volume.
#   Railway: add a volume mounted at /data, then set DB_PATH=/data/city_healer.db
DB_PATH="city_healer.db"

# ─── Optional ──────────────────────────────────────────────────────────────

# Set by the host. Falls back to 3000 locally.
PORT="3000"

# Anonymous access, off unless explicitly enabled. When true an unauthenticated
# caller is bound to a synthetic identity (uid demo-sandbox-user) whose uid
# matches no real patient. For a public demo only; never with real data.
DEMO_MODE="false"

# Ask patients to accept the terms again after this many days. Unset = an acceptance of the
# current terms and privacy versions (shared/consent.ts) does not expire.
CONSENT_MAX_AGE_DAYS=""

# AI requests per user per hour (triage, lab analysis, medicines, diet, assistant). Default 300.
AI_RATE_LIMIT=""

# Serve the API only and skip the frontend middleware entirely. Useful if the
# frontend is hosted separately.
API_ONLY="false"

# Optional LLM (server/ai/llm.ts). Unset = no external AI call at all: symptom triage and
# /api/v1/knowledge/ask answer with City Healer's own offline models, rules and templates.
# When set, the emergency rules still run first and always win; on any error, timeout or
# invalid JSON the offline answer is returned. Responses carry `engine` ("offline" | "llm:<model>").
GEMINI_API_KEY=""
# Models tried in order (failover), each with exponential backoff. Default below.
GEMINI_MODELS="gemini-2.5-flash,gemini-2.0-flash"
# Per-call timeout in ms. Default 8000.
LLM_TIMEOUT_MS=""
